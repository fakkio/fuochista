# Copy to .env and fill in. Never commit .env.

# Signs the session cookie: at least 32 random characters (e.g. `openssl rand -base64 48`).
SESSION_SECRET=

# Set to false only when serving over plain HTTP (local development).
SECURE_COOKIES=true

# Optional. Defaults: 3000 for `npm start`, data/fuochista.db.
# PORT=3000
# DATABASE_PATH=data/fuochista.db

# The official Klover Home app's account. Read from here only, never from code.
KLOVER_EMAIL=
KLOVER_PASSWORD=

# Development only: use an in-memory fake Stove instead of the Klover cloud.
# FAKE_CLOUD=true
