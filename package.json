{
  "name": "fuochista",
  "version": "0.1.1",
  "description": "Unofficial controller for a Micronova Agua IOT pellet stove",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "start": "node src/server.ts",
    "create-user": "node src/cli/create-user.ts",
    "typecheck": "tsc",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "test": "npm run typecheck && npm run test:unit && npm run test:e2e"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fakkio/fuochista.git"
  },
  "license": "MIT",
  "type": "module",
  "bugs": {
    "url": "https://github.com/fakkio/fuochista/issues"
  },
  "homepage": "https://github.com/fakkio/fuochista#readme",
  "dependencies": {
    "@hono/node-server": "^2.1.11",
    "hono": "^4.13.22"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.11",
    "typescript": "^7.0.2",
    "vitest": "^5.1.2"
  },
  "private": true,
  "engines": {
    "node": ">=26"
  }
}
